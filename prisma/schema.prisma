datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
}

model TaiKhoan {
  maTaiKhoan  String @id @db.VarChar(6)
  tenDangNhap String @unique @db.VarChar(50)
  matKhau     String @db.VarChar(250)
}

model DanhMucSanPham {
  maDanhMuc  String    @id @db.VarChar(6)
  tenDanhMuc String    @db.VarChar(50)
  sanPhams   SanPham[]
}

model NhaCungCap {
  maNhaCungCap  String          @id @db.VarChar(6)
  tenNhaCungCap String          @db.VarChar(100)
  soDienThoai   String          @db.VarChar(10)
  email         String?         @db.VarChar(250)
  diaChi        String?         @db.VarChar(250)
  danhMuc       String?         @db.VarChar(20)
  trangThai     String          @default("Đang hợp tác") @db.VarChar(20)
  moTa          String?         @db.VarChar(250)
  phieuNhaps    PhieuNhapHang[]
}

model SanPham {
  maSanPham       String                 @id @db.VarChar(6)
  tenSanPham      String                 @db.VarChar(100)
  maDanhMuc       String                 @db.VarChar(6)
  maVach          String?                @db.VarChar(50)
  donViTinh       String                 @db.VarChar(20)
  giaNhapBinhQuan Decimal                @default(0) @db.Decimal(18, 2)
  soLuongTon      Int                    @default(0)
  mucTonToiThieu  Int                    @default(0)
  quanLyHanSuDung Boolean                @default(false)
  trangThai       String                 @default("Đang kinh doanh") @db.VarChar(20)
  moTa            String?                @db.VarChar(250)

  danhMuc         DanhMucSanPham         @relation(fields: [maDanhMuc], references: [maDanhMuc])
  donViQuyDois    DonViQuyDoi[]
  chiTietNhaps    ChiTietNhapHang[]
  phieuDieuChinhs PhieuDieuChinhTonKho[]
  chiTietHoaDons  ChiTietHoaDon[]
  chiTietDoiTras  ChiTietDoiTra[]
}

model DonViQuyDoi {
  maDonVi     String            @id @db.VarChar(6)
  maSanPham   String            @db.VarChar(6)
  tenDonVi    String            @db.VarChar(50)
  heSoQuyDoi  Int
  giaBan      Decimal           @db.Decimal(18, 2)

  sanPham     SanPham           @relation(fields: [maSanPham], references: [maSanPham], onDelete: Cascade)
  lichSuGia   LichSuGiaBan[]
  chiTietNhap ChiTietNhapHang[]
  chiTietHD   ChiTietHoaDon[]
  chiTietDT   ChiTietDoiTra[]
}

model LichSuGiaBan {
  maLichSu        String      @id @db.VarChar(6)
  maDonVi         String      @db.VarChar(6)
  giaCu           Decimal     @db.Decimal(18, 2)
  giaMoi          Decimal     @db.Decimal(18, 2)
  thoiDiemThayDoi DateTime    @default(now())

  donVi           DonViQuyDoi @relation(fields: [maDonVi], references: [maDonVi], onDelete: Cascade)
}

model PhieuNhapHang {
  maPhieuNhap  String            @id @db.VarChar(6)
  maNhaCungCap String            @db.VarChar(6)
  ngayNhap     DateTime          @default(now())
  tongTien     Decimal           @db.Decimal(18, 2)

  nhaCungCap   NhaCungCap        @relation(fields: [maNhaCungCap], references: [maNhaCungCap])
  chiTietNhaps ChiTietNhapHang[]
}

model ChiTietNhapHang {
  maChiTietNhap   String                 @id @db.VarChar(6)
  maPhieuNhap     String                 @db.VarChar(6)
  maSanPham       String                 @db.VarChar(6)
  maDonViNhap     String                 @db.VarChar(6)
  tyLeQuyDoi      Int
  soLuongNhap     Int
  soLuongCon      Int                    @default(0) // Số lượng còn (tính theo đơn vị cơ sở)
  giaNhap         Decimal                @db.Decimal(18, 2)
  thanhTien       Decimal                @db.Decimal(18, 2)
  hanSuDung       DateTime?

  phieuNhap       PhieuNhapHang          @relation(fields: [maPhieuNhap], references: [maPhieuNhap])
  sanPham         SanPham                @relation(fields: [maSanPham], references: [maSanPham])
  donViNhap       DonViQuyDoi            @relation(fields: [maDonViNhap], references: [maDonVi])
  phieuDieuChinhs PhieuDieuChinhTonKho[]
  phanBoXuatKhos  PhanBoXuatKho[]
}

model PhieuDieuChinhTonKho {
  maPhieuDieuChinh String          @id @db.VarChar(6)
  maSanPham        String          @db.VarChar(6)
  maChiTietNhap    String          @db.VarChar(6)
  ngayDieuChinh    DateTime        @default(now())
  soLuongCu        Int
  soLuongMoi        Int
  lyDo             String          @db.VarChar(250)
  chenhLech        Int

  sanPham          SanPham         @relation(fields: [maSanPham], references: [maSanPham])
  chiTietNhap      ChiTietNhapHang @relation(fields: [maChiTietNhap], references: [maChiTietNhap])
}

model KhachHang {
  maKhachHang String    @id @db.VarChar(6)
  tenKhachHang String   @db.VarChar(50)
  soDienThoai String    @unique @db.VarChar(10)
  diaChi      String?   @db.VarChar(250)

  hoaDons     HoaDon[]
}

model HoaDon {
  maHoaDon            String          @id @db.VarChar(6)
  maKhachHang         String?         @db.VarChar(6)
  ngayGioBan          DateTime        @default(now())
  tongTien            Decimal         @db.Decimal(18, 2)
  phuongThucThanhToan String          @db.VarChar(20)
  tienKhachDua        Decimal?        @db.Decimal(18, 2)
  tienThua            Decimal?        @db.Decimal(18, 2)
  trangThai           String          @default("Đã thanh toán") @db.VarChar(20)
  lyDoHuy             String?         @db.VarChar(250)
  thoiGianHuy         DateTime?

  khachHang           KhachHang?      @relation(fields: [maKhachHang], references: [maKhachHang])
  chiTietHoaDons      ChiTietHoaDon[]
  phieuDoiTras        PhieuDoiTra[]
}

model ChiTietHoaDon {
  maChiTietHoaDon String          @id @db.VarChar(6)
  maHoaDon        String          @db.VarChar(6)
  maSanPham       String          @db.VarChar(6)
  maDonViBan      String          @db.VarChar(6)
  tyLeQuyDoi      Int
  soLuong         Int
  donGia          Decimal         @db.Decimal(18, 2)
  giaVonBinhQuan  Decimal         @db.Decimal(18, 2)
  thanhTien       Decimal         @db.Decimal(18, 2)

  hoaDon          HoaDon          @relation(fields: [maHoaDon], references: [maHoaDon])
  sanPham         SanPham         @relation(fields: [maSanPham], references: [maSanPham])
  donViBan        DonViQuyDoi     @relation(fields: [maDonViBan], references: [maDonVi])
  phanBoXuatKhos  PhanBoXuatKho[]
  chiTietDoiTras  ChiTietDoiTra[]
}

model PhieuDoiTra {
  maPhieuDoiTra   String          @id @db.VarChar(6)
  maHoaDon        String          @db.VarChar(6)
  ngayGioDoiTra   DateTime        @default(now())
  tongTienHangTra Decimal         @db.Decimal(18, 2)
  tongTienHangDoi Decimal         @db.Decimal(18, 2)
  tienChenhLech   Decimal         @db.Decimal(18, 2)
  trangThai       String          @default("Hoàn tất") @db.VarChar(20)

  hoaDon          HoaDon          @relation(fields: [maHoaDon], references: [maHoaDon])
  chiTietDoiTras  ChiTietDoiTra[]
}

model ChiTietDoiTra {
  maChiTiet       String          @id @db.VarChar(6)
  maPhieuDoiTra   String          @db.VarChar(6)
  maChiTietHoaDon String?         @db.VarChar(6)
  maDonVi         String          @db.VarChar(6)
  maSanPham       String          @db.VarChar(6)
  maPhanBo        String?         @db.VarChar(6)
  loaiDong        String          @db.VarChar(20) // "Hàng trả", "Hàng đổi"
  tyLeQuyDoi      Int
  soLuong         Int
  donGia          Decimal         @db.Decimal(18, 2)
  giaVonBinhQuan  Decimal         @db.Decimal(18, 2)
  thanhTien       Decimal         @db.Decimal(18, 2)
  duocNhapLaiKho  Boolean         @default(true)

  phieuDoiTra     PhieuDoiTra     @relation(fields: [maPhieuDoiTra], references: [maPhieuDoiTra])
  chiTietHoaDon   ChiTietHoaDon?  @relation(fields: [maChiTietHoaDon], references: [maChiTietHoaDon])
  donVi           DonViQuyDoi     @relation(fields: [maDonVi], references: [maDonVi])
  sanPham         SanPham         @relation(fields: [maSanPham], references: [maSanPham])
  phanBoXuatKhos  PhanBoXuatKho[]
}

model PhanBoXuatKho {
  maPhanBo        String           @id @db.VarChar(6)
  maChiTietNhap   String           @db.VarChar(6)
  maChiTietHoaDon String?          @db.VarChar(6)
  maChiTietDoiTra String?          @db.VarChar(6)
  soLuongXuat     Int // Số lượng xuất (theo đơn vị cơ sở)

  chiTietNhap     ChiTietNhapHang  @relation(fields: [maChiTietNhap], references: [maChiTietNhap])
  chiTietHoaDon   ChiTietHoaDon?   @relation(fields: [maChiTietHoaDon], references: [maChiTietHoaDon])
  chiTietDoiTra   ChiTietDoiTra?   @relation(fields: [maChiTietDoiTra], references: [maChiTiet])
}

model IdempotencyKey {
  key       String   @id @db.VarChar(64)
  action    String   @db.VarChar(50)
  response  String?  @db.Text
  createdAt DateTime @default(now())
}
